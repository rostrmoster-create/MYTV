# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret (CHANGE THIS!)
SESSION_SECRET=change_this_to_a_random_secret_string_min_32_characters

# CORS - Your frontend URL
FRONTEND_URL=https://rostrmoster-create.github.io

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
